# Server port
PORT=3000

# Node environment. Use "development" locally, "production" when deployed.
NODE_ENV=development

# Public base URL for all callbacks (Meta webhook, Google OAuth, WhatsApp
# Embedded Signup). REQUIRED in production and must start with https://.
# In development it falls back to http://localhost:<PORT> when unset.
BASE_URL=https://coachpilot-ai.onrender.com

# Meta WhatsApp Cloud API webhook verify token.
# This must match the token you configure in the Meta App Dashboard.
# Canonical name: WEBHOOK_VERIFY_TOKEN. The legacy WHATSAPP_VERIFY_TOKEN is
# still accepted as a fallback if WEBHOOK_VERIFY_TOKEN is unset.
WEBHOOK_VERIFY_TOKEN=your_verify_token_here

# Meta App Secret — used to verify the X-Hub-Signature-256 on incoming webhooks.
# Found in Meta App Dashboard > Settings > Basic. REQUIRED in production.
WHATSAPP_APP_SECRET=your_meta_app_secret_here

# DEV ONLY: when NODE_ENV=development AND this is "true", incoming webhooks are
# accepted WITHOUT a valid signature (so local curl testing works).
# This bypass is ignored in production. Defaults to disabled.
ALLOW_UNSIGNED_WEBHOOKS=false

# OpenRouter (OpenAI-compatible) provider for the intent parser.
OPENROUTER_API_KEY=your_openrouter_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-chat

# --- Google Calendar (service account) ---
# Service account email, e.g. coachpilot@project-id.iam.gserviceaccount.com
GOOGLE_CLIENT_EMAIL=your_service_account_email_here

# Service account private key. Keep the literal \n sequences; they are
# converted to real newlines at runtime. Wrap the whole value in quotes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# The coach's Google Calendar ID (share the calendar with the service account).
GOOGLE_CALENDAR_ID=your_calendar_id_here

# --- Google OAuth (per-coach Calendar connection) ---
# From Google Cloud Console > APIs & Services > Credentials > OAuth client (Web).
# The redirect URI must be added to the OAuth client's authorized redirect URIs.
GOOGLE_OAUTH_CLIENT_ID=your_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_oauth_client_secret
# OPTIONAL: when unset it is derived from BASE_URL as
# ${BASE_URL}/oauth/google/callback. Set it only to override.
# GOOGLE_OAUTH_REDIRECT_URI=https://coachpilot-ai.onrender.com/oauth/google/callback

# IANA timezone used for all scheduling (defaults to Asia/Hong_Kong).
GOOGLE_CALENDAR_TIMEZONE=Asia/Hong_Kong

# --- Coach configuration (single-coach pilot / default coach record) ---
# Identifier for the default coach. Used both as the Firestore `coaches`
# document id and as the local fallback when a webhook has no phone_number_id.
DEFAULT_COACH_ID=coach_default
# Profile fields used by the seed script (npm run seed:coach).
COACH_NAME=Coach Demo
COACH_EMAIL=coach@example.com
COACH_SPORT=Basketball
# Reply language for FAQ defaults ("zh" or "en").
COACH_LANGUAGE=en
COACH_TIMEZONE=Asia/Hong_Kong
# Default coaching session length in minutes.
SESSION_DURATION_MINUTES=60
# Gap to keep between sessions, in minutes.
BUFFER_MINUTES=0
# Weekly working hours. Day keys: sun,mon,tue,wed,thu,fri,sat. Omitted days are
# treated as closed. If unset/invalid, defaults to every day 18:00–22:00.
WORKING_HOURS_JSON={"sun":[{"start":"18:00","end":"22:00"}],"mon":[{"start":"18:00","end":"22:00"}],"tue":[{"start":"18:00","end":"22:00"}],"wed":[{"start":"18:00","end":"22:00"}],"thu":[{"start":"18:00","end":"22:00"}],"fri":[{"start":"18:00","end":"22:00"}],"sat":[{"start":"10:00","end":"18:00"}]}

# --- WhatsApp Cloud API (sending) ---
# Permanent or temporary access token from the Meta App Dashboard.
WHATSAPP_TOKEN=your_whatsapp_access_token_here

# The phone number ID of your WhatsApp Business number.
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# Graph API version (defaults to v25.0).
WHATSAPP_API_VERSION=v25.0

# App access token used to validate connected coach tokens via debug_token
# (post-Embedded-Signup setup). Optional: when unset, "{APP_ID}|{APP_SECRET}"
# is used as a fallback. Never logged.
META_APP_ACCESS_TOKEN=

# --- Admin dashboard (coach onboarding UI at /admin) ---
# Single shared password that gates the /admin pages. REQUIRED to use the UI.
ADMIN_PASSWORD=change_me_admin_password

# Support email shown to coaches for guided WhatsApp setup during the pilot.
# Defaults to support@coachpilot.ai when unset.
SUPPORT_EMAIL=support@coachpilot.ai

# --- WhatsApp Embedded Signup (optional; foundation) ---
# Meta App ID and the Embedded Signup configuration id. When both are set, the
# coach detail page shows a "Connect with Facebook" button.
WHATSAPP_APP_ID=your_meta_app_id
WHATSAPP_CONFIG_ID=your_embedded_signup_config_id

# Feature flag: when "true", the webhook sends real messages via the Meta API.
# When anything else (or unset), replies are only logged — useful for local
# testing without sending live messages. Defaults to disabled.
ENABLE_REAL_WHATSAPP=false

# Recipient phone number used by the standalone send test (npm run test:whatsapp).
TEST_PHONE_NUMBER=85291234567

# --- Firebase / Firestore (conversation context + webhook idempotency) ---
# From the service account JSON in Firebase Console > Project Settings >
# Service accounts. When unset, the app runs in degraded mode (no persistence).
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_service_account_email
# Keep the literal \n sequences; they are converted to real newlines at runtime.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# --- Coach login (Firebase Authentication: Email/Password) ---
# Web API Key from Firebase Console > Project settings > General. Required so the
# server can verify a coach's email + password. Enable the Email/Password sign-in
# provider under Firebase Console > Authentication > Sign-in method.
FIREBASE_API_KEY=your_firebase_web_api_key
