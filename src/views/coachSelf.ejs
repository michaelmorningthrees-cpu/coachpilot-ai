<%- include('partials/head', { title }) %>
<%- include('partials/navCoach') %>
<div class="wrap">
  <h1><%= coach.name %></h1>
  <p class="mut">
    <span class="pill <%= coach.status %>"><%= coach.status %></span>
    <% if (ready) { %><span class="mut"> · ready ✓</span><% } else { %><span class="mut"> · setup incomplete</span><% } %>
  </p>

  <% if (isActive && ready) { %><div class="banner ok">CoachPilot AI is ready 🚀</div><% } %>
  <% if (changed) { %><div class="banner ok">Password updated.</div><% } %>
  <% if (saved) { %><div class="banner ok">Saved.</div><% } %>
  <% if (googleStatus === 'connected') { %><div class="banner ok">Google Calendar connected successfully.</div><% } %>
  <% if (googleStatus === 'failed') { %><div class="banner err">We couldn’t connect your Google Calendar. Please try again.</div><% } %>
  <% if (whatsappStatus === 'connected') { %><div class="banner ok">WhatsApp connected successfully.</div><% } %>
  <% if (whatsappStatus === 'failed') { %><div class="banner err">We couldn’t connect WhatsApp. Please try again or contact support.</div><% } %>

  <!-- Profile -->
  <form action="/coach/profile" method="post">
    <div class="card">
      <h2>Profile</h2>
      <div class="row">
        <div>
          <label for="name">Name</label>
          <input id="name" name="name" value="<%= coach.name %>" />
        </div>
        <div>
          <label for="sport">Sport</label>
          <input id="sport" name="sport" value="<%= coach.sport %>" />
        </div>
      </div>
      <div class="row">
        <div>
          <label for="timezone">Timezone</label>
          <input id="timezone" name="timezone" value="<%= coach.timezone %>" />
        </div>
        <div>
          <label for="language">Reply language</label>
          <select id="language" name="language">
            <option value="en" <%= coach.language === 'en' ? 'selected' : '' %>>English</option>
            <option value="zh" <%= coach.language === 'zh' ? 'selected' : '' %>>中文 / 廣東話</option>
          </select>
        </div>
      </div>
      <label for="calendarId">Google Calendar ID</label>
      <input id="calendarId" name="calendarId" value="<%= coach.calendar && coach.calendar.calendarId ? coach.calendar.calendarId : '' %>" />
      <label for="workingHoursJson">Working hours (JSON)</label>
      <textarea id="workingHoursJson" name="workingHoursJson"><%= workingHoursJson %></textarea>

      <h3 style="font-size:14px;color:var(--mut);margin-top:18px">FAQ &amp; pricing (used for auto-replies)</h3>
      <div class="row">
        <div>
          <label for="faqVenue">Venue / location</label>
          <input id="faqVenue" name="faqVenue" value="<%= coach.faq && coach.faq.venue ? coach.faq.venue : '' %>" />
        </div>
        <div>
          <label for="faqDuration">Session duration</label>
          <input id="faqDuration" name="faqDuration" value="<%= coach.faq && coach.faq.duration ? coach.faq.duration : '' %>" />
        </div>
      </div>
      <label for="pricingText">Pricing answer</label>
      <input id="pricingText" name="pricingText" value="<%= coach.pricing && coach.pricing.text ? coach.pricing.text : '' %>" />

      <div class="actions">
        <button type="submit">Save profile</button>
      </div>
    </div>
  </form>

  <!-- Google Calendar -->
  <%
    var googleConnected = coach.calendar && coach.calendar.serviceAccountMode === false && coach.calendar.refreshToken;
    var selectedCalendarId = (coach.calendar && coach.calendar.calendarId) || 'primary';
  %>
  <div class="card">
    <h2>Google Calendar</h2>
    <% if (googleConnected) { %>
      <p class="mut">Connected via your Google account ✓</p>
    <% } else { %>
      <p class="mut">Connect your own Google account so bookings land in your calendar:</p>
    <% } %>
    <div class="actions">
      <a class="btn" href="/coach/google/start">
        <%= googleConnected ? 'Reconnect Google Calendar' : 'Connect Google Calendar' %>
      </a>
    </div>

    <% if (googleConnected && calendars && calendars.length) { %>
      <form action="/coach/calendar" method="post" style="margin-top:16px">
        <label for="calendarChoice">Calendar to use</label>
        <select id="calendarChoice" name="calendarId">
          <% calendars.forEach(function (c) { %>
            <option value="<%= c.id %>" <%= c.id === selectedCalendarId ? 'selected' : '' %>>
              <%= c.summary %><%= c.primary ? ' (primary)' : '' %>
            </option>
          <% }) %>
        </select>
        <div class="actions">
          <button type="submit" class="btn secondary">Save calendar</button>
        </div>
      </form>
    <% } else if (googleConnected) { %>
      <p class="mut" style="font-size:13px;margin-top:12px">Bookings go to your <strong>primary</strong> calendar.</p>
    <% } %>
  </div>

  <!-- WhatsApp Connection (coach-friendly) -->
  <%
    var wa = coach.whatsapp || {};
    var waConnected = Boolean(wa.phoneNumberId && wa.accessToken);
    var warns = wa.setupWarnings || [];
    var needsAttention = waConnected && (!wa.webhookSubscribed || !wa.phoneRegistered || warns.length > 0);
    // ⭕ = not done yet, ✅ = ok, ⚠ = needs attention
    function statusIcon(done) { return !waConnected ? '⭕' : (done ? '✅' : '⚠'); }
  %>
  <div class="card">
    <h2>WhatsApp Connection</h2>
    <p class="mut" style="margin-top:0">
      Status:
      <% if (!waConnected) { %>
        <span class="pill setup_pending">Not connected</span>
      <% } else if (needsAttention) { %>
        <span class="pill setup_pending">Needs attention</span>
      <% } else { %>
        <span class="pill active">Connected</span>
      <% } %>
      <% if (waConnected && wa.displayPhoneNumber) { %> · <span class="muted-code"><%= wa.displayPhoneNumber %></span><% } %>
    </p>

    <!-- Setup checklist -->
    <ul style="list-style:none;padding:0;margin:10px 0;font-size:14px;line-height:2">
      <li><%= waConnected ? '✅' : '⭕' %> WhatsApp connected</li>
      <li><%= statusIcon(wa.tokenValidated) %> Token validated</li>
      <li><%= statusIcon(wa.webhookSubscribed) %> Webhook subscribed</li>
      <li><%= statusIcon(wa.phoneRegistered) %> Phone registered</li>
    </ul>

    <% if (waConnected && !wa.webhookSubscribed) { %>
      <div class="banner err">WhatsApp connected, but the message webhook needs attention. Try “Retry setup” below or contact support.</div>
    <% } %>
    <% if (warns.indexOf('PHONE_REGISTRATION_PIN_REQUIRED') !== -1) { %>
      <div class="banner err">Phone registration needs a 6-digit PIN. CoachPilot support will help you complete this step.</div>
    <% } %>

    <% if (!waConnected) { %>
      <!-- Pilot: self-connect when available, otherwise guided support -->
      <% if (embedded) { %>
        <p class="mut">Connect your WhatsApp Business account in a few clicks — no technical details needed.</p>
        <div class="actions">
          <button type="button" class="btn" onclick="launchWhatsAppSignup()">Connect WhatsApp Business</button>
          <span id="es-status" class="mut"></span>
        </div>
        <p class="mut" style="font-size:13px;margin-top:10px">
          Prefer help? <a href="mailto:<%= supportEmail %>?subject=WhatsApp%20setup%20help">Request WhatsApp Setup Support</a>
        </p>
      <% } else { %>
        <p class="mut">CoachPilot team will help you connect your WhatsApp Business account during pilot.</p>
        <div class="actions">
          <a class="btn" href="mailto:<%= supportEmail %>?subject=WhatsApp%20setup%20help"
             onclick="var m=document.getElementById('wa-support-msg'); if(m){m.textContent='Please contact CoachPilot support with your WhatsApp Business number.';}">
            Request WhatsApp Setup Support
          </a>
          <span id="wa-support-msg" class="mut"></span>
        </div>
      <% } %>
    <% } else { %>
      <!-- Connected: allow re-run of automated setup, and reconnect if available -->
      <div class="actions">
        <form action="/coach/whatsapp/retry-setup" method="post" style="display:inline">
          <button type="submit" class="btn secondary">Retry setup</button>
        </form>
        <% if (embedded) { %>
          <button type="button" class="btn ghost" onclick="launchWhatsAppSignup()">Reconnect WhatsApp Business</button>
          <span id="es-status" class="mut"></span>
        <% } %>
      </div>
      <% if (needsAttention) { %>
        <p class="mut" style="font-size:13px;margin-top:10px">
          Still stuck? <a href="mailto:<%= supportEmail %>?subject=WhatsApp%20setup%20help">Request WhatsApp Setup Support</a>
        </p>
      <% } %>
    <% } %>

    <details style="margin-top:18px">
      <summary style="cursor:pointer;color:var(--mut);font-size:13px;user-select:none">Advanced manual setup</summary>
      <div style="margin-top:14px">
        <p class="mut" style="font-size:13px">Only needed if you already have your own WhatsApp Cloud API credentials.</p>
        <form action="/coach/whatsapp" method="post">
          <div class="row">
            <div>
              <label for="phoneNumberId">Phone number ID</label>
              <input id="phoneNumberId" name="phoneNumberId" value="<%= wa.phoneNumberId || '' %>" />
            </div>
            <div>
              <label for="displayPhoneNumber">Display phone number (optional)</label>
              <input id="displayPhoneNumber" name="displayPhoneNumber" value="<%= wa.displayPhoneNumber || '' %>" />
            </div>
          </div>
          <label for="accessToken">Access token</label>
          <input id="accessToken" name="accessToken" type="password" placeholder="<%= waConnected ? '•••••• (stored — re-enter to replace)' : 'Permanent or system-user token' %>" />
          <div class="actions">
            <button type="submit">Save WhatsApp</button>
          </div>
        </form>

        <form action="/coach/whatsapp/pin" method="post" style="margin-top:18px">
          <label for="registrationPin">Registration PIN (optional)</label>
          <input id="registrationPin" name="registrationPin" type="password" autocomplete="off"
                 placeholder="<%= (wa.registrationPin) ? '•••••• (stored — re-enter to replace)' : '6-digit phone registration PIN' %>" />
          <p class="mut" style="font-size:12px;margin:6px 0 0">Used to register your number automatically. Stored securely and never shown again.</p>
          <div class="actions">
            <button type="submit" class="secondary">Save PIN</button>
          </div>
        </form>
      </div>
    </details>
  </div>
</div>

<% if (embedded) { %>
<script>
  const ES_APP_ID = '<%= embedded.appId %>';
  const ES_CONFIG_ID = '<%= embedded.configId %>';
  const ES_VERSION = '<%= embedded.apiVersion %>';
  const ES_COACH_NAME = <%- JSON.stringify(coach.name || '') %>;
  const ES_DISPLAY_PHONE = <%- JSON.stringify((coach.whatsapp && coach.whatsapp.displayPhoneNumber) || '') %>;
  let waSessionData = {};

  window.fbAsyncInit = function () {
    FB.init({ appId: ES_APP_ID, autoLogAppEvents: true, xfbml: true, version: ES_VERSION });
  };

  // Capture phone_number_id / waba_id emitted by the Embedded Signup flow.
  window.addEventListener('message', function (event) {
    if (typeof event.origin !== 'string' || !event.origin.endsWith('facebook.com')) return;
    try {
      const data = JSON.parse(event.data);
      if (data.type === 'WA_EMBEDDED_SIGNUP' && data.data) {
        waSessionData = data.data;
      }
    } catch (e) { /* ignore non-JSON messages */ }
  });

  function setStatus(msg) { document.getElementById('es-status').textContent = msg; }

  function launchWhatsAppSignup() {
    if (typeof FB === 'undefined') { setStatus('Facebook SDK not loaded yet — try again.'); return; }
    console.log('[WHATSAPP EMBEDDED START]');
    setStatus('Opening Meta…');

    // Pre-fill the coach's business name and (if known) display phone number.
    var setup = { business: { name: ES_COACH_NAME } };
    if (ES_DISPLAY_PHONE) { setup.phone = { display_phone_number: ES_DISPLAY_PHONE }; }

    FB.login(function (response) {
      if (response && response.authResponse && response.authResponse.code) {
        submitEmbedded(response.authResponse.code);
      } else {
        setStatus('Signup cancelled.');
      }
    }, {
      config_id: ES_CONFIG_ID,
      response_type: 'code',
      override_default_response_type: true,
      extras: {
        setup: setup,
        featureType: 'whatsapp_embedded_signup',
        sessionInfoVersion: 3
      }
    });
  }

  function submitEmbedded(code) {
    setStatus('Connecting…');
    fetch('/coach/whatsapp/embedded/callback', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        code: code,
        phoneNumberId: waSessionData.phone_number_id || '',
        wabaId: waSessionData.waba_id || ''
      })
    }).then(function (r) { return r.json(); }).then(function (res) {
      if (res.ok) { setStatus('Connected ✓ reloading…'); location.href = '/coach?whatsapp=connected'; }
      else { setStatus('Failed.'); location.href = '/coach?whatsapp=failed'; }
    }).catch(function () { location.href = '/coach?whatsapp=failed'; });
  }
</script>
<script async defer crossorigin="anonymous" src="https://connect.facebook.net/en_US/sdk.js"></script>
<% } %>
</body>
</html>
