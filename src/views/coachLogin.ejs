<%- include('partials/head', { title }) %>
<div class="wrap" style="max-width:420px;margin-top:64px">
  <div class="card">
    <h1>Coach Login</h1>
    <p class="mut">Sign in with the email and password your admin gave you.</p>
    <% if (error) { %>
      <div class="banner err"><%= error %></div>
    <% } %>
    <form action="/coach/login" method="post">
      <label for="email">Email</label>
      <input type="email" id="email" name="email" autocomplete="username" autofocus required />
      <label for="password">Password</label>
      <input type="password" id="password" name="password" autocomplete="current-password" required />
      <div class="actions">
        <button type="submit">Log in</button>
      </div>
    </form>
  </div>
</div>
</body>
</html>
