<%- include('partials/head', { title }) %>
<div class="wrap" style="max-width:420px;margin-top:64px">
  <div class="card">
    <h1>Admin Login</h1>
    <p class="mut">Enter the admin password to manage coaches.</p>
    <% if (!configured) { %>
      <div class="banner err">ADMIN_PASSWORD is not set in .env. Set it and restart the server.</div>
    <% } %>
    <% if (error) { %>
      <div class="banner err"><%= error %></div>
    <% } %>
    <form action="/admin/login" method="post">
      <label for="password">Password</label>
      <input type="password" id="password" name="password" autofocus required />
      <div class="actions">
        <button type="submit">Log in</button>
      </div>
    </form>
  </div>
</div>
</body>
</html>
