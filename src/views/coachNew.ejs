<%- include('partials/head', { title }) %>
<%- include('partials/nav') %>
<div class="wrap">
  <h1>New Coach</h1>
  <p class="mut"><a href="/admin">← Back to coaches</a></p>

  <% if (error) { %>
    <div class="banner err"><%= error %></div>
  <% } %>

  <form action="/admin/coaches" method="post">
    <div class="card">
      <h2>Profile</h2>
      <div class="row">
        <div>
          <label for="coachId">Coach ID *</label>
          <input id="coachId" name="coachId" placeholder="coach_jane" required />
        </div>
        <div>
          <label for="name">Name *</label>
          <input id="name" name="name" placeholder="Jane Wong" required />
        </div>
      </div>
      <div class="row">
        <div>
          <label for="email">Email</label>
          <input id="email" name="email" type="email" placeholder="jane@example.com" />
        </div>
        <div>
          <label for="sport">Sport</label>
          <input id="sport" name="sport" placeholder="basketball / tennis / fitness …" />
        </div>
      </div>
      <div class="row">
        <div>
          <label for="timezone">Timezone</label>
          <input id="timezone" name="timezone" value="Asia/Hong_Kong" />
        </div>
        <div>
          <label for="language">Default language</label>
          <select id="language" name="language">
            <option value="en">English</option>
            <option value="zh">中文 / 廣東話</option>
          </select>
        </div>
      </div>
      <label for="calendarId">Google Calendar ID (optional; can connect via OAuth later)</label>
      <input id="calendarId" name="calendarId" placeholder="coach@gmail.com" />
      <label for="workingHoursJson">Working hours (JSON)</label>
      <textarea id="workingHoursJson" name="workingHoursJson"><%= defaultWorkingHours %></textarea>
      <p class="mut">Day keys: sun,mon,tue,wed,thu,fri,sat. Empty array = closed.</p>
      <div class="actions">
        <button type="submit">Create coach</button>
        <a class="btn ghost" href="/admin">Cancel</a>
      </div>
    </div>
  </form>
</div>
</body>
</html>
