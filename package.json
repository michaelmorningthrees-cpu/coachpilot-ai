{
  "name": "coachpilot-ai",
  "version": "0.1.0",
  "description": "CoachPilot AI - WhatsApp booking assistant for sports coaches (Step 1: Webhook server)",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/app.js",
    "dev": "ts-node src/app.ts",
    "dev:watch": "ts-node-dev --respawn --transpile-only src/app.ts",
    "typecheck": "tsc --noEmit",
    "test:calendar": "ts-node src/scripts/testCalendarConnection.ts",
    "test:freebusy": "ts-node src/scripts/testFreeBusy.ts",
    "test:whatsapp": "ts-node src/scripts/testWhatsAppSend.ts",
    "test:context": "ts-node src/scripts/testFirestoreContext.ts",
    "test:idempotency": "ts-node src/scripts/testIdempotency.ts",
    "test:resolver": "ts-node src/scripts/testDateTimeResolver.ts",
    "test:workinghours": "ts-node src/scripts/testWorkingHours.ts",
    "test:flow": "ts-node src/scripts/testWebhookFlow.ts",
    "seed:coach": "ts-node src/scripts/seedDefaultCoach.ts",
    "test:seed": "ts-node src/scripts/testSeedDefaultCoach.ts",
    "test:resolver:coach": "ts-node src/scripts/testCoachResolver.ts",
    "test:multicoach": "ts-node src/scripts/testMultiCoachFlow.ts",
    "test:oauth:url": "ts-node src/scripts/testGoogleOAuthUrl.ts"
  },
  "keywords": [
    "whatsapp",
    "webhook",
    "express",
    "typescript"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "ejs": "^6.0.1",
    "express": "^4.22.2",
    "firebase-admin": "^14.1.0",
    "googleapis": "^173.0.0",
    "luxon": "^3.7.2",
    "openai": "^6.45.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/luxon": "^3.7.2",
    "@types/node": "^20.19.43",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "author": "",
  "type": "commonjs"
}
